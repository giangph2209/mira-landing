# ---------------------------------------------------------------------------
# Database (service `postgres` trong docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=mira
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=mira

# Host `postgres` = tên service trong compose. Chạy dev ngoài Docker thì đổi thành localhost.
#
# Postgres tự quản (Docker):
#   DATABASE_URL=postgresql://USER:PASS@postgres:5432/DB?schema=public&connection_limit=10
#   DIRECT_URL=postgresql://USER:PASS@postgres:5432/DB?schema=public      (trùng, không có pooler)
#
# Supabase + serverless (Vercel) — PHẢI tách đôi:
#   # app lúc chạy: transaction pooler 6543. Để session pooler (5432) ở đây sẽ gặp
#   # FATAL: (EMAXCONNSESSION) max clients reached in session mode — pool_size: 15
#   DATABASE_URL=postgresql://USER:PASS@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   # prisma migrate: session pooler 5432. Transaction pooler không giữ session nên
#   # migrate treo vô hạn.
#   DIRECT_URL=postgresql://USER:PASS@HOST.pooler.supabase.com:5432/postgres
DATABASE_URL=

# BẮT BUỘC — schema.prisma khai báo `directUrl`, thiếu biến này Prisma throw lúc khởi động.
DIRECT_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# CHÚ Ý: biến NEXT_PUBLIC_* được inline vào bundle LÚC BUILD, không đọc lại lúc chạy.
# docker-compose truyền giá trị này xuống `build.args`, nên đổi nó phải `docker compose build`
# lại, `restart` không có tác dụng.
NEXT_PUBLIC_SITE_URL=https://dvltechco.com

# Đặt "false" khi chạy dev qua http:// (cookie Secure không gửi được trên http)
SESSION_COOKIE_SECURE=true

# Múi giờ dùng để gom nhóm số liệu theo ngày trên dashboard
ANALYTICS_TIMEZONE=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------------
# Chỉ dùng cho lệnh seed tài khoản admin đầu tiên — không giữ trong env container đang chạy
#   docker compose exec -e ADMIN_EMAIL=... -e ADMIN_PASSWORD=... nextjs node prisma/seed.mjs
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@dvltechco.com
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên
